# OpenRouter (LLM triage) — required
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Resend (email digest) — required
RESEND_API_KEY=
REPORT_EMAIL_FROM=onboarding@resend.dev
REPORT_EMAIL_TO=you@example.com

# Semantic Scholar (reputation lookups) — optional but recommended
# Without a key you're limited to a low shared unauthenticated rate.
# Get a free key at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# OpenReview (optional) — only needed for higher rate limits on public data
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=

# Substack draft post (write_post.py) — see README "Substack draft post"
# https://<name>.substack.com (not a custom domain)
SUBSTACK_PUBLICATION_URL=
# The full Cookie request header of a logged-in substack.com session (DevTools →
# Network → any substack.com request → Request Headers → Cookie). It expires, and
# signing out of Substack invalidates it.
SUBSTACK_COOKIE=
# Optional: OpenRouter model for writing the post (default: OPENROUTER_MODEL)
SUBSTACK_WRITER_MODEL=
# Optional: proxy for Substack calls only, e.g. socks5h://127.0.0.1:40000
SUBSTACK_PROXY=
