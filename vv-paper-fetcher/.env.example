# OpenRouter (LLM triage) — required
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Resend (email digest) — required
RESEND_API_KEY=
REPORT_EMAIL_FROM=onboarding@resend.dev
REPORT_EMAIL_TO=you@example.com

# Semantic Scholar (reputation lookups) — optional but recommended
# Without a key you're limited to a low shared unauthenticated rate.
# Get a free key at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# OpenReview (optional) — only needed for higher rate limits on public data
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=
